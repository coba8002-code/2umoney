      "level": "기본",
      "titleKo": "컨트롤 레이블 제공",
      "requirement": "모든 사용자 컨트롤에 용도·목적을 알 수 있는 시각적·비시각적 레이블이 제공되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["vision", "ocr", "speech"],
      "a11yRuleId": "control.label",
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.instruction.clear",
      "clause": ["XLSX 73행"],
