{
  "$schema": "./criteria.schema.json",
  "version": "2025.1",
  "standard": {
    "verification": "무인정보단말기 접근성 검증 기준 [별표5] (제18조제1항 관련)",
    "guideline": "KS X 9211:2025 무인정보단말기 접근성 지침",
    "notice": "요건 텍스트는 표준 원문을 패러프레이즈하고 조항으로 출처를 표기함(원문 저작권 KATS·MOTIE). 임계값·수치는 사실 정보."
  },
  "modalityLabels": {
    "vision": "화면 비전 분석",
    "ocr": "문자 인식(OCR)",
    "speech": "음성/청각 분석",
    "ui-flow": "조작 흐름·상호작용 분석",
    "video": "영상 프레임 분석",
    "llm": "언어 판단(LLM)",
    "measure": "현장 실측(수기·센서)"
  },
  "categoryLabels": {
    "hand": "손·팔 동작 보완",
    "response": "반응 시간 보완",
    "sight": "시력 보완·대체",
    "hearing": "청력 보완·대체",
    "cognition": "인지 보완",
    "io": "입·출력 및 기타"
  },
  "criteria": [
    {
      "id": "kiosk.control.oneHand",
      "clause": ["별표5 1.a"],
      "category": "hand",
      "level": "기본",
      "titleKo": "한 손 조작 가능",
      "requirement": "모든 작동부(터치스크린·물리 작동부·연결 자판 포함)를 한 손으로 조작할 수 있어야 한다.",
      "judgment": "pass-fail",
      "modality": ["ui-flow", "measure"],
      "source": "manual",
      "needsMeasurement": true
    },
    {
      "id": "kiosk.button.gap",
      "clause": ["별표5 1.b"],
      "category": "hand",
      "level": "기본",
      "titleKo": "버튼 간 간격",
      "requirement": "이웃한 버튼 사이에 구분 가능한 간격을 둔다(터치 2.5mm 이상, 물리 작동부 0.5mm 이상).",
      "judgment": "pass-fail",
      "grades": ["우수", "보통"],
      "gradeRule": "우수=모든 터치·물리 버튼 2.5mm 이상, 보통=터치 2.5mm·물리 0.5mm 이상",
      "modality": ["vision"],
      "a11yRuleId": null,
      "thresholds": { "gapTouchMm": 2.5, "gapPhysicalMm": 0.5 },
      "source": "ai-assisted",
      "needsMeasurement": true
    },
    {
      "id": "kiosk.button.mbr",
      "clause": ["별표5 1.c"],
      "category": "hand",
      "level": "기본",
      "titleKo": "버튼 최소 크기(MBR)",
      "requirement": "모든 작동부의 최소경계상자(MBR)는 각 변 12mm 이상, 표면적 144mm² 이상이어야 한다(단말기 축 정렬 기준).",
      "judgment": "pass-fail",
      "modality": ["vision"],
      "a11yRuleId": "target.size",
      "thresholds": { "minSideMm": 12, "minAreaMm2": 144 },
      "source": "ai-assisted",
      "needsMeasurement": true
    },
    {
      "id": "kiosk.motion.userControl",
      "clause": ["별표5 2.a"],
      "category": "response",
      "level": "기본",
      "titleKo": "자동 변경 콘텐츠 제어",
      "requirement": "자동으로 변경되는 콘텐츠가 있으면 사용자가 그 움직임을 제어할 수 있어야 한다.",
      "judgment": "pass-fail",
      "modality": ["ui-flow", "video"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.time.limit",
      "clause": ["별표5 2.b"],
      "category": "response",
      "level": "기본",
      "titleKo": "시간 제한·연장 안내",
      "requirement": "조작에 충분한 시간 제한을 두고, 만료 최소 20초 전 알림과 연장 방법을 제공해야 한다.",
      "judgment": "pass-fail",
      "modality": ["ui-flow"],
      "thresholds": { "warnBeforeSec": 20 },
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.time.reset",
      "clause": ["별표5 2.c(계열)"],
      "category": "response",
      "level": "해당시",
      "titleKo": "초기화 및 매체 회수",
      "requirement": "시간 만료·명시적 조작으로 초기화되며, 초기화 시 이전 세션 정보가 삭제되고 삽입된 카드 등 매체를 회수할 수 있어야 한다.",
      "judgment": "pass-fail",
      "modality": ["ui-flow"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.sight.nonVisual",
      "clause": ["KS X 9211 4.2.1", "별표5 3.계열"],
      "category": "sight",
      "level": "기본",
      "titleKo": "시각을 필요로 하지 않는 방법",
      "requirement": "시각을 사용하지 않고도(청각·촉각 등) 단말기를 사용할 수 있는 방법이 하나 이상 제공되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["speech", "ui-flow"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.sight.altAudio",
      "clause": ["KS X 9211 4.x", "XLSX 16~18행"],
      "category": "sight",
      "level": "기본",
      "titleKo": "시각정보의 청각 대체",
      "requirement": "의미 있는 모든 시각정보에 동등한 음성 대체가 제공되고, 사용자가 선택·반복 청취할 수 있어야 한다.",
      "judgment": "pass-fail",
      "modality": ["speech", "ocr", "vision"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.text.size",
      "clause": ["XLSX 19~20행"],
      "category": "sight",
      "level": "기본",
      "titleKo": "텍스트 크기·확대",
      "requirement": "의미 있는 텍스트의 실제 문자 높이가 7.25mm 이상이고, 200% 확대 시 콘텐츠·기능이 손실되지 않아야 한다(영상 자막 제외).",
      "judgment": "pass-fail",
      "modality": ["ocr", "vision", "ui-flow"],
      "a11yRuleId": "text.size",
      "thresholds": { "minCharHeightMm": 7.25, "zoomPct": 200 },
      "source": "ai-assisted",
      "needsMeasurement": true
    },
    {
      "id": "kiosk.color.independence",
      "clause": ["KS X 9211 4.2.3", "XLSX 21행"],
      "category": "sight",
      "level": "기본",
      "titleKo": "색에 무관한 정보 인식",
      "requirement": "색이 정보 전달·행동 지시·요소 구분의 유일한 수단으로 사용되지 않아야 한다.",
      "judgment": "pass-fail",
      "modality": ["vision"],
      "a11yRuleId": "link.identifiable",
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.contrast",
      "clause": ["XLSX 22~23행"],
      "category": "sight",
      "level": "기본",
      "titleKo": "텍스트·기능키 명도 대비",
      "requirement": "의미 있는 텍스트와 기능 키 레이블이 배경과 4.5:1 이상의 명도 대비를 이루고, 컨트롤이 배경과 시각적으로 구분되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["ocr", "vision"],
      "a11yRuleId": "contrast.text",
      "thresholds": { "minRatio": 4.5 },
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.ui.distinguish",
      "clause": ["XLSX 61~62행"],
      "category": "sight",
      "level": "기본",
      "titleKo": "콘텐츠·조작요소 구분",
      "requirement": "이웃한 콘텐츠가 시각적으로 구분되고, 조작 가능한 UI 요소가 조작 불가능한 요소와 명확히 구별되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["vision"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.hearing.altVisual",
      "clause": ["XLSX 25행"],
      "category": "hearing",
      "level": "기본",
      "titleKo": "청각정보의 시각 대체",
      "requirement": "의미 있는 모든 청각정보가 텍스트·이미지·지시등 상태 등 동등한 시각정보와 함께 제공되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["speech", "ocr"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.audio.volumeControl",
      "clause": ["별표5 3.b", "XLSX 26·28·32행"],
      "category": "hearing",
      "level": "기본",
      "titleKo": "음량 조절·재생 중단",
      "requirement": "스피커·개인청취장치의 음량 조절, 음소거, 음성 안내 재생 중단 수단이 제공되어야 한다.",
      "judgment": "pass-fail",
      "modality": ["ui-flow", "measure"],
      "source": "manual",
      "needsMeasurement": true
    },
    {
      "id": "kiosk.video.photosensitivity",
      "clause": ["XLSX 33행"],
      "category": "sight",
      "level": "해당시",
      "titleKo": "광과민성 발작 방지",
