      "judgment": "pass-fail",
      "modality": ["video"],
      "thresholds": { "maxFlashesPerSec": 3 },
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.keyboard.navigation",
      "clause": ["별표5 3.d·3.e", "XLSX 36·66~71행"],
      "category": "sight",
