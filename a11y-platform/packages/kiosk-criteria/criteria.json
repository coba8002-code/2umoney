      "judgment": "pass-fail",
      "modality": ["llm"],
      "source": "ai-assisted",
      "needsMeasurement": false
    },
    {
      "id": "kiosk.privacy.sensitive",
      "clause": ["XLSX 93행"],
      "category": "io",
      "level": "해당시",
      "titleKo": "민감정보 화면 노출 방지",
